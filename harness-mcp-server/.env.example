# Copy to .env for LOCAL DEVELOPMENT ONLY. Never commit a real .env file
# (see .gitignore / .dockerignore). In Kubernetes, these same variable names
# are supplied via deploy/k8s/configmap.yaml (non-secret) and a Secret
# resource synced from Vault/AWS Secrets Manager by your secrets operator
# (see deploy/k8s/secret.example.yaml) -- never as a plaintext file on disk.

# ---- Server / transport -----------------------------------------------
# stdio = single local user, one SAT (dev only). http = multi-user, the
# server holds zero credentials and each caller supplies x-harness-api-key.
MCP_MODE=stdio
HTTP_HOST=0.0.0.0
HTTP_PORT=8443
# true = TLS/mTLS is terminated by an ingress/service-mesh sidecar in front
# of this pod. false = this process terminates TLS itself using
# TLS_CERT_PATH/TLS_KEY_PATH. Plaintext HTTP is never permitted in HTTP mode.
TLS_TERMINATED_UPSTREAM=true
TLS_CERT_PATH=
TLS_KEY_PATH=

# ---- Hard safety constraint --------------------------------------------
# MUST be "none". Any other value fails startup validation. This is not a
# tunable default -- see guardrails/approval_hook.py.
HARNESS_AUTO_APPROVE_RISK=none

# ---- Harness -------------------------------------------------------------
HARNESS_EDITION=saas
HARNESS_ACCOUNT_ID=
HARNESS_ORG_ID=
HARNESS_PROJECT_ID=
HARNESS_BASE_URL=https://app.harness.io/
# stdio mode only: the env var name (not the value!) that holds a scoped
# Harness Service Account Token for local/dev single-user use.
HARNESS_STDIO_TOKEN_ENV_VAR=HARNESS_SAT_TOKEN
# HARNESS_SAT_TOKEN=   # set this (not committed) for local stdio dev only

# ---- Secrets backend -----------------------------------------------------
# vault | aws-secrets-manager
SECRETS_BACKEND=vault

VAULT_ADDR=
# kubernetes | approle | token
VAULT_AUTH_METHOD=kubernetes
VAULT_ROLE=
VAULT_KV_MOUNT=secret
VAULT_KV_PATH_PREFIX=harness-mcp-server
# Only used with VAULT_AUTH_METHOD=approle / token (dev only) -- not read by
# Settings directly, read straight from the environment by vault_provider.py:
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
# VAULT_TOKEN=

AWS_SECRETS_MANAGER_REGION=
AWS_SECRETS_MANAGER_PREFIX=harness-mcp-server/

# ---- Approval / confirmation ----------------------------------------
CONFIRMATION_TTL_SECONDS=300
# memory (single replica only) | redis (required for multi-replica HTTP mode)
CONFIRMATION_STORE_BACKEND=memory
REDIS_URL=

# ---- Audit -----------------------------------------------------------
# true (recommended for prod): if every configured audit sink fails to
# write, the tool call fails rather than proceeding silently unaudited.
AUDIT_FAIL_CLOSED=true
AUDIT_LOCAL_FILE_PATH=/var/log/harness-mcp/audit.jsonl
AUDIT_S3_BUCKET=
AUDIT_S3_REGION=
AUDIT_S3_PREFIX=harness-mcp-audit/
AUDIT_WEBHOOK_URL=
# A reference/key name to look up in the secrets backend -- never the
# secret value itself.
AUDIT_WEBHOOK_SIGNING_SECRET_REF=

# ---- Observability -----------------------------------------------------
LOG_LEVEL=INFO
METRICS_PORT=9090
